FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --gid 65532 gateway \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin gateway

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/findver_gateway ./src/findver_gateway
RUN python -m pip install ".[gateway]"

USER 65532:65532
CMD ["uvicorn", "--factory", "findver_gateway.app:app_factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]

